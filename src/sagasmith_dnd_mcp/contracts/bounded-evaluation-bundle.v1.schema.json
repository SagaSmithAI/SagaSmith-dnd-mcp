{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagasmith.ai/contracts/bounded-evaluation-bundle.v1.schema.json",
  "title": "SagaSmith bounded semantic evaluation bundle v1",
  "type": "object",
  "required": ["schema_version", "bundle_id", "purpose", "authority", "subject", "context", "constraints", "bundle_receipt"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "purpose": {"enum": ["actor_turn", "audience_render", "faction_turn", "source_interpretation", "bounded_ruling"]},
    "authority": {
      "type": "object",
      "required": ["campaign_id", "branch_id", "head_snapshot_id", "campaign_revision", "latest_event_sequence", "host_context_binding"],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1},
        "branch_id": {"type": "string", "minLength": 1},
        "head_snapshot_id": {"type": ["string", "null"]},
        "campaign_revision": {"type": "integer", "minimum": 0},
        "latest_event_sequence": {"type": "integer", "minimum": 0},
        "host_context_binding": {"$ref": "#/$defs/hostContextBinding"}
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": {"enum": ["actor", "audience", "faction", "source", "ruling"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "name": {"type": "string", "maxLength": 300}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["question", "question_basis_ref", "actor", "interlocutors", "stimulus", "facts", "actor_knowledge", "events", "scene", "source_evidence", "audience"],
      "properties": {
        "question": {"type": "string"},
        "question_basis_ref": {"type": "string"},
        "actor": {"type": ["object", "null"]},
        "interlocutors": {"type": "array", "items": {"type": "object"}},
        "stimulus": {"type": ["object", "null"]},
        "facts": {"type": "array", "items": {"type": "object"}},
        "actor_knowledge": {"type": "array", "items": {"type": "object"}},
        "events": {"type": "array", "items": {"type": "object"}},
        "scene": {"type": ["object", "null"]},
        "source_evidence": {"type": "array", "items": {"type": "object"}},
        "audience": {"type": "string"}
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "required": ["allowed_basis_refs", "allowed_claim_basis_refs", "decision_only_basis_refs", "allowed_target_refs", "may_roll_dice", "may_call_tools", "may_write_state", "output_contract"],
      "properties": {
        "allowed_basis_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "allowed_claim_basis_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "decision_only_basis_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "allowed_target_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "may_roll_dice": {"const": false},
        "may_call_tools": {"const": false},
        "may_write_state": {"const": false},
        "output_contract": {"enum": ["actor-turn-proposal.v1", "audience-render-proposal.v1", "faction-turn-proposal.v1", "source-interpretation-proposal.v1", "bounded-ruling-proposal.v1"]}
      },
      "additionalProperties": false
    },
    "bundle_receipt": {
      "type": "object",
      "required": ["schema_version", "purpose", "bundle_id", "bundle_digest", "principal_fingerprint", "subject_ref", "allowed_basis_refs", "allowed_claim_basis_refs", "allowed_target_refs", "question_digest", "signature"],
      "properties": {
        "schema_version": {"const": 1},
        "purpose": {"enum": ["actor_turn", "audience_render", "faction_turn", "source_interpretation", "bounded_ruling"]},
        "bundle_id": {"type": "string"},
        "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "principal_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "subject_ref": {"type": "string", "minLength": 1},
        "allowed_basis_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "allowed_claim_basis_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "allowed_target_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "question_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "hostContextBinding": {
      "type": "object",
      "required": ["domain", "campaign_id", "principal_fingerprint", "role", "audience", "branch_id", "authorization_fingerprint", "memory_policy", "context_epoch"],
      "properties": {
        "domain": {"const": "sagasmith-dnd"},
        "campaign_id": {"type": "string", "minLength": 1},
        "principal_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authorization_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"enum": ["owner", "dm", "player"]},
        "audience": {"enum": ["dm", "player"]},
        "branch_id": {"type": "string", "minLength": 1},
        "memory_policy": {"const": "domain_authoritative"},
        "context_epoch": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"purpose": {"const": "actor_turn"}}}, "then": {"properties": {"constraints": {"properties": {"output_contract": {"const": "actor-turn-proposal.v1"}}}}}},
    {"if": {"properties": {"purpose": {"const": "audience_render"}}}, "then": {"properties": {"constraints": {"properties": {"output_contract": {"const": "audience-render-proposal.v1"}}}}}},
    {"if": {"properties": {"purpose": {"const": "faction_turn"}}}, "then": {"properties": {"constraints": {"properties": {"output_contract": {"const": "faction-turn-proposal.v1"}}}}}},
    {"if": {"properties": {"purpose": {"const": "source_interpretation"}}}, "then": {"properties": {"constraints": {"properties": {"output_contract": {"const": "source-interpretation-proposal.v1"}}}}}},
    {"if": {"properties": {"purpose": {"const": "bounded_ruling"}}}, "then": {"properties": {"constraints": {"properties": {"output_contract": {"const": "bounded-ruling-proposal.v1"}}}}}}
  ],
  "additionalProperties": false
}
