{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagasmith.ai/contracts/source-interpretation-proposal.v1.schema.json",
  "title": "SagaSmith source interpretation proposal v1",
  "type": "object",
  "required": ["schema_version", "bundle_id", "purpose", "question", "interpretation", "claims", "ambiguities", "requires_dm_review"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "purpose": {"const": "source_interpretation"},
    "question": {"type": "string", "minLength": 1, "maxLength": 2000},
    "interpretation": {"type": "string", "minLength": 1, "maxLength": 6000},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["statement", "basis_refs", "posture"],
        "properties": {
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "basis_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "posture": {"enum": ["supported", "inference", "uncertain", "opinion", "nonfactual"]}
        },
        "additionalProperties": false
      }
    },
    "ambiguities": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "uniqueItems": true},
    "requires_dm_review": {"type": "boolean"}
  },
  "additionalProperties": false
}
